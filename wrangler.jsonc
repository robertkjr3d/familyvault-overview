{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "triggers": {
    "crons": ["0 20 * * *"]
  },
  "r2_buckets": [
    { "binding": "BACKUPS_BUCKET", "bucket_name": "familyhub-backups" }
  ]
}

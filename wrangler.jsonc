{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "triggers": {
    "crons": ["0 20 * * *"]
  },
  "r2_buckets": [
    { "binding": "BACKUPS_BUCKET", "bucket_name": "familyhub-backups" }
  ],
  // "ratelimits" is Cloudflare's native Workers rate-limiting binding — no separate resource
  // to create first (unlike the R2 bucket above), this alone provisions it on deploy.
  // namespace_id is just an arbitrary integer unique within this account, not a lookup key.
  // period MUST be 10 or 60 (seconds) — that's a hard platform limit, not a choice; there is
  // no native "N per hour" option without extra infrastructure (Durable Objects/KV).
  "ratelimits": [
    {
      "name": "INVITE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
